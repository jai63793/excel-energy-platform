# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/excel_energy"

# JWT Authentication Secrets
JWT_SECRET=supersecretjwtkey12345!@#
JWT_REFRESH_SECRET=supersecretrefreshjwtkey98765!@#

# Razorpay Payment Gateway (Test or Live Mode keys)
RAZORPAY_KEY_ID=rzp_test_yourkeyhere
RAZORPAY_KEY_SECRET=yourkeysecrethere
RAZORPAY_WEBHOOK_SECRET=yourwebhooksecrethere

# OTP Service Providers (Twilio or MSG91)
# Set SMS_PROVIDER=twilio, msg91 or mock
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MSG91_AUTH_KEY=your_msg91_auth_key_here

# WhatsApp Business API Config
# Set WHATSAPP_PROVIDER=meta or mock
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Email SMTP Settings (for invoice & reminders)
# Set EMAIL_PROVIDER=smtp or mock
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Excel Energy <no-reply@excelenergy.com>

# Firebase Admin SDK Configuration (Optional: for real Firebase OTP validation)
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=your_client_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Database Seeding Credentials
SEED_ADMIN_PHONE=9999999999
SEED_ADMIN_USERNAME=excel_admin
SEED_ADMIN_EMAIL=admin@excelenergy.com
SEED_ADMIN_PASSWORD=adminpassword123

SEED_USER_PHONE=9876543210
SEED_USER_USERNAME=excel_user_paid
SEED_USER_EMAIL=amit@gmail.com
SEED_USER_PASSWORD=userpassword123

SEED_UNPAID_USER_PHONE=8765432109
SEED_UNPAID_USER_USERNAME=excel_user_unpaid
SEED_UNPAID_USER_EMAIL=neha@gmail.com
SEED_UNPAID_USER_PASSWORD=userpassword123

SEED_HEALER_PHONE=7654321098
SEED_HEALER_USERNAME=healer_rajesh
SEED_HEALER_EMAIL=rajesh@excelenergy.com
SEED_HEALER_PASSWORD=healerpassword123

