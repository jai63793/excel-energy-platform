# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/excel_energy"

# JWT Authentication Secrets
JWT_SECRET=supersecretjwtkey12345!@#
JWT_REFRESH_SECRET=supersecretrefreshjwtkey98765!@#

# Razorpay Payment Gateway (Test or Live Mode keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here


# OTP Service Providers (Twilio or MSG91)
# Set SMS_PROVIDER=twilio, msg91 or mock
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MSG91_AUTH_KEY=your_msg91_auth_key_here

# Scopycode SMS Gateway (WhatsApp Business Reseller) Configuration
# Set SMS_PROVIDER=scopycode to use the Scopycode gateway.
SCOPYCODE_SMS_URL=https://app.scopycode.in/api/sendtemplate.php
SCOPYCODE_API_KEY=your_scopycode_api_key_here
SCOPYCODE_LICENSE_NUMBER=your_scopycode_license_number_here
SCOPYCODE_SENDER_ID=Vikas
SCOPYCODE_DLT_TEMPLATE_ID=verify_code5
SCOPYCODE_LIVE_TEMPLATE_ID=youtube_live_invite
SCOPYCODE_BROADCAST_TEMPLATE_ID=admin_announcement

# WhatsApp Business API Config
# Set WHATSAPP_PROVIDER=meta or mock
WHATSAPP_PROVIDER=mock
WHATSAPP_BUSINESS_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Email SMTP Settings (for invoice & reminders)
# Set EMAIL_PROVIDER=smtp or mock
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=Excel Energy <no-reply@excelenergy.com>

# Firebase Admin SDK Configuration (Optional: for real Firebase OTP validation)
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_PRIVATE_KEY="your_firebase_private_key_here"


# Database Seeding Credentials
SEED_ADMIN_PHONE=your_seed_admin_phone_here
SEED_ADMIN_USERNAME=your_seed_admin_username_here
SEED_ADMIN_EMAIL=your_seed_admin_email_here
SEED_ADMIN_PASSWORD=your_seed_admin_password_here

SEED_USER_PHONE=your_seed_user_phone_here
SEED_USER_USERNAME=your_seed_user_username_here
SEED_USER_EMAIL=your_seed_user_email_here
SEED_USER_PASSWORD=your_seed_user_password_here

SEED_UNPAID_USER_PHONE=your_seed_unpaid_user_phone_here
SEED_UNPAID_USER_USERNAME=your_seed_unpaid_user_username_here
SEED_UNPAID_USER_EMAIL=your_seed_unpaid_user_email_here
SEED_UNPAID_USER_PASSWORD=your_seed_unpaid_user_password_here

SEED_HEALER_PHONE=your_seed_healer_phone_here
SEED_HEALER_USERNAME=your_seed_healer_username_here
SEED_HEALER_EMAIL=your_seed_healer_email_here
SEED_HEALER_PASSWORD=your_seed_healer_password_here

